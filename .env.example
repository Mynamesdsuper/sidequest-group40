# Root environment, read by docker-compose.yml. Copy to `.env` (never commit `.env`).
# Development credentials only: the database runs locally in Docker.
POSTGRES_USER=sidequest
POSTGRES_PASSWORD=sidequest
POSTGRES_DB=sidequest_dev
# Host port of the database container. Change it if 5432 is already used (e.g. a local PostgreSQL),
# and use the same port in backend/.env (DATABASE_URL, TEST_DATABASE_URL).
DB_PORT=5432
# Host port of Adminer (`docker compose --profile tools up -d`).
ADMINER_PORT=8080
