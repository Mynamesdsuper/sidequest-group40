# Backend environment. Copy to `.env` (never commit `.env`). Checked at boot by src/shared/config.
NODE_ENV=development
PORT=3000
# Same port as DB_PORT in the root .env (docker-compose.yml). Credentials: root .env.
DATABASE_URL=postgres://sidequest:sidequest@localhost:5432/sidequest_dev
TEST_DATABASE_URL=postgres://sidequest:sidequest@localhost:5432/sidequest_test
# JWT secret (same name as in the lectures). Generate a long random value for your .env.
TOKEN_SECRET=change-me
TOKEN_EXPIRES_IN=2h
FRONTEND_ORIGIN=http://localhost:4200
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=5
